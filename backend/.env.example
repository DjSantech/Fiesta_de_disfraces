# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.

NODE_ENV=development
PORT=4000

# Local: MongoDB embebido (npm run db). Producción: cadena de MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/fiesta_disfraces

# Secreto para firmar los tokens del staff. En producción: 64+ caracteres aleatorios.
JWT_SECRET=

# URL pública del frontend (Cloudflare) y del backend (Render). Se usan para CORS y Mercado Pago.
# Puedes poner varios orígenes en FRONTEND_URL separados por coma; el primero se usa para los enlaces.
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# Primer usuario administrador (se crea solo si no existe ningún usuario).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mercado Pago (https://www.mercadopago.com.co/developers/panel/app). Vacío en local = modo simulado.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Opcionales para "npm run db" (MongoDB local persistente). Por defecto: 27017 y %USERPROFILE%\.fiesta-disfraces\mongo-data
# MONGO_DEV_PORT=27017
# MONGO_DEV_DBPATH=
